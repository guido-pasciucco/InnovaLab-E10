# Env for the e2e suite (Playwright + local Supabase CLI stack).
# Copy to .env.test (gitignored): cp .env.test.example .env.test
# Values come from `bunx supabase status` after `bun run supabase:start`.
# Every URL here MUST be local: playwright.config.ts aborts otherwise.

# Local API gateway (Kong)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# "Publishable" key (or the legacy "anon" key) printed by `supabase status`.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
# "Secret" key (or the legacy "service_role" key) printed by `supabase status`.
# Test process only (factories/fixtures use it for the Admin API). Never
# NEXT_PUBLIC_; playwright.config.ts strips it from the webServer env.
SUPABASE_SECRET_KEY=replace-with-local-secret-key

# Must equal the Playwright baseURL and supabase/config.toml site_url.
SITE_URL=http://127.0.0.1:3100

# Local Postgres (direct connection, no pooler locally)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Mailpit web UI + REST API ([local_smtp] port in supabase/config.toml)
MAILPIT_URL=http://127.0.0.1:54324
