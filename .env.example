# Supabase API (placeholders only, never real secrets)
# Get values from: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Public origin of the app, used for links sent by email (password reset).
# Required in production (the app refuses to trust request headers there).
# Optional locally, where it falls back to the request host.
SITE_URL=http://localhost:3000

# Postgres wire connections for Drizzle (placeholders only)
# Get values from: Supabase Dashboard > Project Settings > Database > Connection string
# Pooler (6543) for app runtime queries
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct (5432) for drizzle-kit migrations
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Copy to .env.local for local development: cp .env.example .env.local
# Never commit .env.local with real credentials.

# Help assistant. Leave HELP_ENABLED unset to keep the button hidden.
# HELP_MODEL is the application inference profile ARN, not the foundation model id.
# Visual-only preview. Accepted only by `next dev` with a loopback SITE_URL;
# never add this variable to `.env.deploy` or a hosted environment.
# HELP_PREVIEW=true
# HELP_ENABLED=true
# HELP_PROVIDER=bedrock
# HELP_MODEL=arn:aws:bedrock:<region>:<account>:application-inference-profile/<id>
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# "Chateá con tus datos" (#279). Own IAM user, separate from the help assistant.
# Stage 1 only uses the AWS keys and the embedding model, for the ingestion
# script. CHAT_DATOS_ENABLED and CHAT_DATOS_MODEL are read from stage 3 on.
# Leave the keys empty here; real values belong in .env.local.
CHAT_DATOS_ENABLED=false
CHAT_DATOS_SHOW_SQL=false
CHAT_DATOS_AWS_ACCESS_KEY_ID=
CHAT_DATOS_AWS_SECRET_ACCESS_KEY=
CHAT_DATOS_MODEL=anthropic.claude-haiku-4-5-20251001-v1:0
CHAT_DATOS_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
