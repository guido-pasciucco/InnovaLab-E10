# Plantilla de credenciales para deployar.
# Copiar a .env.deploy (ignorado por git) y completar los valores:
#
#   cp .env.deploy.example .env.deploy
#
# Los valores salen de:
#   Supabase Dashboard > Project Settings > Database > Connection string
#   Supabase Dashboard > Project Settings > API
#
# Ojo: en el pooler el usuario NO es "postgres", es "postgres.<project-ref>".
# Si la contraseña tiene @ : / # ? hay que URL-encodearla (@ -> %40).

# URL pública de la app en Vercel. Se conoce después de `vercel link`.
SITE_URL=https://<tu-proyecto>.vercel.app

# Runtime (transaction pooler, puerto 6543)
DATABASE_URL="postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Migraciones (session pooler, puerto 5432). Opcional para el deploy.
DIRECT_URL="postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres"

# Cliente de Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<tu_key>
