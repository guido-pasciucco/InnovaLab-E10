        <mxCell id="footer" value="No hay S3, ni Knowledge Base, ni un agente de Bedrock, ni capacidad reservada. Para apagarlo: HELP_ENABLED=false, un deploy y borrar las claves de AWS en Vercel. Sin invocaciones no queda nada facturando." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F7F8;strokeColor=#E6E8EC;fontFamily=Helvetica;fontSize=13;fontColor=#1F2933;align=left;spacingLeft=14;spacingRight=14;" vertex="1" parent="1">
